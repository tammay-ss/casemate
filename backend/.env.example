PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/casemate
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated origins. Set this to your Vercel production URL on Render.
CLIENT_ORIGINS=http://localhost:3000,https://your-project.vercel.app
# Firebase is optional during local development. Add these to enable document uploads.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=
# Google OAuth Web client ID. Use the same value in the frontend as REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
